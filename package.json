{
  "name": "@nodemy-official/circuit-module",
  "version": "0.1.0",
  "description": "DC circuit model, editing, simulation, and optional React editor UI.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": ["./dist/ui/*.css"],
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/circuit-model.d.ts",
      "import": "./dist/circuit-model.js"
    },
    "./geometry": {
      "types": "./dist/circuit-geometry.d.ts",
      "import": "./dist/circuit-geometry.js"
    },
    "./edit": {
      "types": "./dist/circuit-edit.d.ts",
      "import": "./dist/circuit-edit.js"
    },
    "./solver": {
      "types": "./dist/circuit-solver.d.ts",
      "import": "./dist/circuit-solver.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/ui/*.css dist/ui/",
    "check": "tsc --noEmit && vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "engines": {
    "node": ">=22"
  }
}
